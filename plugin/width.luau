local function within(ranges: { { number } }, c: number): boolean
	local lo, hi = 1, #ranges
	while lo <= hi do
		local mid = (lo + hi) // 2
		local r = ranges[mid]
		if c < r[1] then
			hi = mid - 1
		elseif c > r[2] then
			lo = mid + 1
		else
			return true
		end
	end
	return false
end

-- Cells of one code point: 0, 1 or 2.
function width.char(c: number): number
	if c >= 0x20 and c < 0x7F then
		return 1
	end
	if within(ZERO, c) then
		return 0
	end
	return if within(WIDE, c) then 2 else 1
end

local function is_flag_letter(c: number): boolean
	return c >= 0x1F1E6 and c <= 0x1F1FF
end

local function is_skin_tone(c: number): boolean
	return c >= 0x1F3FB and c <= 0x1F3FF
end

local function is_pictographic(c: number): boolean
	return within(PICT, c)
end

-- Cells of one line, one emoji sequence at a time. Invalid UTF-8 counts one
-- cell per byte.
function width.cells(line: string): number
	local ok, n = pcall(function(): number
		local w = 0
		local last = 0 -- cells of the previous visible glyph
		local base = 0 -- the previous visible code point
		local pict = false -- the previous visible glyph is an emoji
		local joining = false -- an emoji then a ZWJ: a following emoji joins it
		local joined = false -- the previous visible code point joined across a ZWJ
		local flag_open = false -- one regional indicator is waiting for its pair
		for _, c in utf8.codes(line) do
			if joining then
				joining = false
				if is_pictographic(c) then
					-- joined into the emoji before the ZWJ: no extra cells
					joined = true
					base = c
					continue
				end
			end
			if c == 0x200D then
				joining = pict
			elseif c == 0xFE0F then
				-- emoji presentation: a text-default symbol or keycap base becomes two cells
				if last == 1 and within(VSBASE, base) then
					w += 1
					last = 2
				end
			elseif c == 0xFE0E then
				if joined then
					-- VS15 breaks the ZWJ sequence (UTS #51): the joined
					-- component renders on its own, as text when it has a text form
					local cw = if within(VSBASE, base) then 1 else width.char(base)
					w += cw
					last = cw
				elseif last == 2 and within(VSBASE, base) then
					w -= 1
					last = 1
				end
				-- a text-presented glyph never joins across a following ZWJ
				pict = false
				joined = false
			elseif is_skin_tone(c) and within(MODBASE, base) then
				-- part of the glyph before it, which it makes a two-cell emoji
				if last == 1 then
					w += 1
					last = 2
				end
			elseif is_flag_letter(c) then
				if flag_open then
					flag_open = false
				else
					w += 2
					last = 2
					pict = false
					joined = false
					base = 0
					flag_open = true
				end
			else
				flag_open = false
				local cw = width.char(c)
				w += cw
				if cw > 0 then
					last = cw
					joined = false
					base = c
					pict = is_pictographic(c)
				end
			end
		end
		return w
	end)
	return if ok then n else #line
end

-- Rows [first, last] of `total` that fit `room` lines around row `at`, and
-- whether the "↑ more" / "↓ more" lines fit too: rows plus the markers it
-- allows never exceed `room`, and row `at` always shows.
function width.slice(total: number, at: number, room: number): (number, number, boolean, boolean)
	if total <= 0 then
		return 1, 0, false, false
	elseif total <= room then
		return 1, total, false, false
	end
	if room <= 1 then
		return at, at, false, false
	end
	-- near an end only one marker is needed, so the rows get the other line
	if at <= room - 1 then
		return 1, room - 1, false, true
	elseif at >= total - room + 2 then
		return total - room + 2, total, true, false
	end
	local n = math.max(1, room - 2)
	local first = math.clamp(at - n // 2, 1, math.max(1, total - n + 1))
	local last = math.min(total, first + n - 1)
	local up, down = first > 1, last < total
	local spare = room - (last - first + 1)
	if up and down and spare < 2 then
		up = false -- one line left: keep the marker below
		down = spare >= 1
	elseif spare < 1 then
		up, down = false, false
	end
	return first, last, up, down
end

return width
